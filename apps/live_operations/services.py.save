                cursor.execute("""
                    SELECT [Status], [$systemModifiedAt], [Processing Date]
                    FROM [UFAA OPERATIONS$Online Claim$2636ffcf-1aea-4b3a-808a-c1da12e824c1]
                    WHERE [No_] = %s
                """, [claim_no])
                
